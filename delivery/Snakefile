# =============================================================================
# Snakefile — Pipeline Reprodutível de Coleta, Análise e Slides (CMP223)
# =============================================================================
# Como usar (a partir da raiz de delivery/):
#   snakemake -j1              # Roda TUDO sem a placa: compila os 12 firmwares + design + catálogo + notebook + slides
#   snakemake -j1 clean        # Limpa todos os artefatos gerados (firmwares, CSVs, figuras, tabelas, slides e outputs do .ipynb)
#   snakemake -j1 experiment   # Roda nova coleta física na bancada (MCU + LA) e atualiza todo o pipeline
#   snakemake -n               # Dry-run: exibe o grafo de tarefas pendentes sem executar
# =============================================================================

import glob
import json
import os
import pathlib
import shutil
import tarfile

configfile: "src/analysis/config.yaml"

# Caminhos relativos à raiz do pacote
PYTHON = ".venv/bin/python" if os.path.exists(".venv/bin/python") else "python3"
ENV_PREFIX = 'LD_LIBRARY_PATH=".venv/lib:${LD_LIBRARY_PATH:-}"' if os.path.exists(".venv/lib") else ""

RAW_TELEMETRY = sorted(glob.glob("data/experiments/exp_*/raw/telemetry_*.json"))

ALGS = ["kyber512", "ctru-light", "ecdh"]
VARS = ["asm", "ref"]
OPTS = ["O3", "Os"]

FIRMWARE_HEX = [
    f"src/firmware/atmega4809/build/firmware-{alg}-{var}-20MHz-{opt}.hex"
    for alg in ALGS
    for var in VARS
    for opt in OPTS
]

PROCESSED_CSVS = [
    "results/processed/bench_history_tidy.csv",
    "results/processed/campaigns_history.csv",
    "results/processed/bench_tidy.csv",
    "results/processed/la_vs_uart_overhead.csv",
    "results/processed/summary_bench.csv",
    "results/processed/flash_sizes.csv",
    "results/processed/anova_latency.csv",
]

LATEX_TABLES = [
    "results/tables/results.tex",
    "results/tables/anova.tex",
]

FIGURES = [
    "results/figures/historico_todos_experimentos.png",
    "results/figures/historico_todos_experimentos.pdf",
    "results/figures/oscillogram.png",
    "results/figures/drift_kyber_asm.png",
    "results/figures/drift_kyber_asm.pdf",
    "results/figures/flash.png",
    "results/figures/flash.pdf",
    "results/figures/latency.png",
    "results/figures/latency.pdf",
    "results/figures/bimodality.png",
    "results/figures/bimodality.pdf",
    "results/figures/residuals.png",
    "results/figures/residuals.pdf",
    "results/figures/tradeoff.png",
    "results/figures/tradeoff.pdf",
]

SLIDE_FIGURES = [
    "slides/figures/historico_todos_experimentos.png",
    "slides/figures/slide_oscillogram.png",
    "slides/figures/slide_bancada_setup.png",
    "slides/figures/slide_flash.png",
    "slides/figures/slide_bimodality.png",
    "slides/figures/slide_tradeoff.png",
]

SLIDE_DECKS = [
    "results/slides/01-proposta.pdf",
    "results/slides/02-parcial.pdf",
    "results/slides/01-proposta.html",
    "results/slides/02-parcial.html",
]

# ---- Meta padrão (sem placa): compila os 12 firmwares + design + catálogo + notebook + slides ----
rule all:
    input:
        FIRMWARE_HEX,
        "results/processed/design.csv",
        "data/experiments/catalog.csv",
        PROCESSED_CSVS,
        LATEX_TABLES,
        FIGURES,
        SLIDE_FIGURES,
        SLIDE_DECKS

# ---- 0. Compilação bare-metal dos 12 firmwares AVR (ATmega4809 @ 20 MHz) ----
rule build_firmware:
    output:
        hex="src/firmware/atmega4809/build/firmware-{alg}-{var}-20MHz-{opt}.hex"
    shell:
        r"""
        rm -f src/firmware/atmega4809/build/*.o src/firmware/atmega4809/build/*.elf
        make -C src/firmware/atmega4809 ALG={wildcards.alg} VARIANT={wildcards.var} OPT=-{wildcards.opt} F_CPU=20000000UL
        cp src/firmware/atmega4809/build/firmware-{wildcards.alg}-{wildcards.var}.hex {output.hex}
        """

rule firmware:
    input:
        FIRMWARE_HEX

# ---- 1. Matriz de planejamento experimental fatorial (pyDOE3) ----
rule design:
    input:
        "src/analysis/config.yaml"
    output:
        "results/processed/design.csv"
    shell:
        "{ENV_PREFIX} {PYTHON} src/analysis/design.py --config {input} --out {output}"

# ---- 2. Auditoria dos dados brutos e geração do catálogo de campanhas ----
rule catalog:
    input:
        RAW_TELEMETRY
    output:
        "data/experiments/catalog.csv"
    shell:
        "{ENV_PREFIX} {PYTHON} src/analysis/catalog.py"

# ---- 3. Execução completa do caderno analise.ipynb (estatística, tabelas e figuras) ----
rule analysis_notebook:
    input:
        catalog="data/experiments/catalog.csv",
        nb="src/analysis/analise.ipynb",
        photo="slides/figures/bancada.jpg"
    output:
        PROCESSED_CSVS,
        LATEX_TABLES,
        FIGURES,
        SLIDE_FIGURES
    shell:
        "{ENV_PREFIX} {PYTHON} -m jupyter nbconvert --to notebook --execute --inplace {input.nb}"

# ---- 4. Renderização das apresentações Marp (PDF e HTML) ----
rule slides:
    input:
        md1="slides/01-proposta.md",
        md2="slides/02-parcial.md",
        figs=SLIDE_FIGURES
    output:
        SLIDE_DECKS
    shell:
        r"""
        if [ ! -d "node_modules" ]; then npm ci --no-audit --no-fund; fi
        npm run pdf
        npm run html
        """

# ---- 5. Experimento completo na bancada física (com placa conectada) + atualização de tudo ----
rule experiment:
    params:
        mode=config.get("mode", "bench"),
        port=config.get("port", config.get("serial_port", "/dev/ttyACM0")),
        n=config.get("iterations", 30),
        seed=config.get("seed", 42),
        tag=config.get("tag", "bench_campanha_completa_la_nix")
    shell:
        r"""
        {ENV_PREFIX} {PYTHON} src/analysis/run_experiment.py \
            --mode {params.mode} --port {params.port} \
            --alg all --variants asm ref --opts O3 Os --clocks 20 \
            -n {params.n} --seed {params.seed} \
            --tag {params.tag}
        {ENV_PREFIX} {PYTHON} src/analysis/design.py --config src/analysis/config.yaml --out results/processed/design.csv
        {ENV_PREFIX} {PYTHON} src/analysis/catalog.py
        {ENV_PREFIX} {PYTHON} -m jupyter nbconvert --to notebook --execute --inplace src/analysis/analise.ipynb
        if [ ! -d "node_modules" ]; then npm ci --no-audit --no-fund; fi
        npm run pdf
        npm run html
        """

# ---- 6. Apenas coleta física na bancada (ATmega4809 + Analisador Lógico 24 MHz) ----
rule bench:
    params:
        port=config.get("port", config.get("serial_port", "/dev/ttyACM0")),
        n=config.get("iterations", 30),
        seed=config.get("seed", 42),
        tag=config.get("tag", "bench_campanha_completa_la_nix")
    shell:
        r"""
        {ENV_PREFIX} {PYTHON} src/analysis/run_experiment.py \
            --mode bench --port {params.port} \
            --alg all --variants asm ref --opts O3 Os --clocks 20 \
            -n {params.n} --seed {params.seed} \
            --tag {params.tag}
        {ENV_PREFIX} {PYTHON} src/analysis/catalog.py
        """

# ---- 7. Gera o pacote compactado ../delivery.tgz (<16 MB) sem alterar os CSVs em disco ----
rule package:
    run:
        import io
        exclude_dirs = {".venv", "node_modules", ".snakemake", "__pycache__", ".ipynb_checkpoints", "build"}
        exclude_files = {".env", "delivery.tgz", "parcial.tgz"}

        def _compact_la(raw_bytes: bytes, is_kyber_osc: bool) -> bytes:
            lines = raw_bytes.decode("utf-8", errors="replace").splitlines(keepends=True)
            if len(lines) < 5000:
                return raw_bytes
            out, data_rows = [], []
            for line in lines:
                if line.startswith("#") or line.startswith("sample_idx"):
                    out.append(line)
                else:
                    parts = line.split(",")
                    if len(parts) >= 3:
                        data_rows.append((float(parts[1]), parts[2], line))
            n = len(data_rows)
            for i, (t_s, d0, line) in enumerate(data_rows):
                keep = (i == 0 or i == n - 1 or (is_kyber_osc and t_s <= 2.0))
                if not keep and (data_rows[i - 1][1] != d0 or (i + 1 < n and data_rows[i + 1][1] != d0)):
                    keep = True
                if keep:
                    out.append(line)
            return "".join(out).encode("utf-8")

        out_tgz = "../delivery.tgz"
        with tarfile.open(out_tgz, "w:gz") as tar:
            for root, dirs, files in os.walk("."):
                dirs[:] = sorted(d for d in dirs if d not in exclude_dirs)
                rel_root = pathlib.Path("delivery") / pathlib.Path(root)
                tar.add(root, arcname=str(rel_root), recursive=False)
                for fname in sorted(files):
                    if fname in exclude_files or fname.endswith(".pyc"):
                        continue
                    fpath = pathlib.Path(root) / fname
                    arcpath = rel_root / fname
                    parts = arcpath.parts
                    if len(parts) >= 3 and parts[0] == "delivery" and parts[1] == "results" and fname != ".gitkeep":
                        continue
                    if len(parts) == 4 and parts[:3] == ("delivery", "slides", "figures") and fname.endswith(".png"):
                        continue
                    if fname.startswith("la_") and fname.endswith(".csv"):
                        data = _compact_la(fpath.read_bytes(), fname == "la_kyber512_asm_O3_20MHz.csv")
                        ti = tar.gettarinfo(str(fpath), arcname=str(arcpath))
                        ti.size = len(data)
                        tar.addfile(ti, io.BytesIO(data))
                    else:
                        tar.add(str(fpath), arcname=str(arcpath), recursive=False)
        shutil.copy2(out_tgz, "../parcial.tgz")
        size_mb = os.path.getsize(out_tgz) / (1024 * 1024)
        print(f"[PACKAGE] Gerados {out_tgz} e ../parcial.tgz ({size_mb:.2f} MB) — arquivos em disco preservados integralmente.")

# ---- 8. Limpeza de todos os artefatos derivados para testar do zero ----
rule clean:
    run:
        shutil.rmtree("src/firmware/atmega4809/build", ignore_errors=True)
        for pattern in [
            "results/processed/*.csv",
            "results/tables/*.tex",
            "results/figures/*.png",
            "results/figures/*.pdf",
            "results/slides/*",
            "slides/figures/*.png",
        ]:
            for f in glob.glob(pattern):
                if os.path.isfile(f):
                    os.remove(f)
        nb_path = pathlib.Path("src/analysis/analise.ipynb")
        nb = json.loads(nb_path.read_text(encoding="utf-8"))
        for c in nb.get("cells", []):
            if c.get("cell_type") == "code":
                c["outputs"] = []
                c["execution_count"] = None
        nb_path.write_text(json.dumps(nb, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
        print("[OK] Ambiente limpo! Todos os resultados gerados e outputs do notebook foram removidos.")
