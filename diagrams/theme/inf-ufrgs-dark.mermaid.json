{
  "theme": "base",
  "fontFamily": "Inter, 'Segoe UI', Helvetica, Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Inter, 'Segoe UI', Helvetica, Arial, sans-serif",
    "fontSize": "16px",

    "darkMode": true,
    "background": "#111111",
    "primaryColor": "#1E1E1E",
    "primaryTextColor": "#FFFFFF",
    "primaryBorderColor": "#D32F2F",
    "secondaryColor": "#111111",
    "secondaryTextColor": "#E0E0E0",
    "secondaryBorderColor": "#555555",
    "tertiaryColor": "#111111",
    "tertiaryTextColor": "#E0E0E0",
    "tertiaryBorderColor": "#555555",

    "mainBkg": "#1E1E1E",
    "nodeBorder": "#D32F2F",
    "nodeTextColor": "#FFFFFF",
    "lineColor": "#AAAAAA",
    "textColor": "#E0E0E0",
    "titleColor": "#FFFFFF",
    "edgeLabelBackground": "#111111",

    "clusterBkg": "#191919",
    "clusterBorder": "#555555",

    "actorBkg": "#1E1E1E",
    "actorBorder": "#D32F2F",
    "actorTextColor": "#FFFFFF",
    "actorLineColor": "#777777",
    "signalColor": "#AAAAAA",
    "signalTextColor": "#E0E0E0",
    "labelBoxBkgColor": "#D32F2F",
    "labelBoxBorderColor": "#D32F2F",
    "labelTextColor": "#FFFFFF",
    "loopTextColor": "#E0E0E0",
    "noteBkgColor": "#222222",
    "noteBorderColor": "#D32F2F",
    "noteTextColor": "#E0E0E0",
    "activationBkgColor": "#D32F2F",
    "activationBorderColor": "#D32F2F",

    "cScale0": "#FFFFFF",
    "cScale1": "#D32F2F",
    "cScale2": "#AAAAAA",
    "cScale3": "#555555",
    "cScaleLabel0": "#111111",
    "cScaleLabel1": "#FFFFFF",
    "cScaleLabel2": "#111111",
    "cScaleLabel3": "#FFFFFF",

    "pie1": "#FFFFFF",
    "pie2": "#D32F2F",
    "pie3": "#AAAAAA",
    "pie4": "#555555",
    "pie5": "#333333",
    "pieTitleTextColor": "#FFFFFF",
    "pieStrokeColor": "#111111",
    "pieOuterStrokeColor": "#AAAAAA",
    "pieOuterStrokeWidth": "2px",
    "pieOpacity": "1",
    "pieSectionTextSize": "17px",
    "pieSectionTextColor": "#111111",
    "pieLegendTextSize": "16px",
    "pieLegendTextColor": "#E0E0E0",

    "xyChart": {
      "backgroundColor": "#111111",
      "titleColor": "#FFFFFF",
      "xAxisLabelColor": "#E0E0E0",
      "xAxisTitleColor": "#FFFFFF",
      "xAxisTickColor": "#AAAAAA",
      "xAxisLineColor": "#E0E0E0",
      "yAxisLabelColor": "#E0E0E0",
      "yAxisTitleColor": "#FFFFFF",
      "yAxisTickColor": "#AAAAAA",
      "yAxisLineColor": "#E0E0E0",
      "plotColorPalette": "#FFFFFF, #D32F2F, #AAAAAA, #555555"
    },

    "ganttSectionBkgColor": "#1E1E1E",
    "ganttSectionBkgColor2": "#161616",
    "taskBkgColor": "#333333",
    "taskBorderColor": "#AAAAAA",
    "taskTextColor": "#FFFFFF",
    "taskTextLightColor": "#E0E0E0",
    "taskTextOutsideColor": "#E0E0E0",
    "activeTaskBkgColor": "#D32F2F",
    "activeTaskBorderColor": "#D32F2F",
    "doneTaskBkgColor": "#555555",
    "doneTaskBorderColor": "#777777",
    "critBkgColor": "#D32F2F",
    "critBorderColor": "#FFFFFF",
    "gridColor": "#333333",
    "todayLineColor": "#D32F2F"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "padding": 12,
    "nodeSpacing": 45,
    "rankSpacing": 55,
    "useMaxWidth": false
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": false
  },
  "gantt": {
    "useMaxWidth": false
  }
}
