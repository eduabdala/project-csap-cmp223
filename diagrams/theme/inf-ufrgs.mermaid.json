    "cScaleLabel2": "#FFFFFF",
    "cScaleLabel3": "#222222",

    "pie1": "#111111",
    "pie2": "#D32F2F",
    "pie3": "#555555",
    "pie4": "#9E9E9E",
    "pie5": "#E0E0E0",
    "pieTitleTextSize": "20px",
    "pieTitleTextColor": "#111111",
