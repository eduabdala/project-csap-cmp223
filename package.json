{
  "name": "project-csap-cmp223",
  "private": true,
  "version": "1.0.0",
  "description": "Slides e artigo do trabalho de CMP223 (INF-UFRGS)",
  "scripts": {
    "pdf": "marp --config marp.config.mjs --input-dir marp-ppt --output dist/slides --pdf",
    "pptx": "marp --config marp.config.mjs --input-dir marp-ppt --output dist/slides --pptx",
    "html": "marp --config marp.config.mjs --input-dir marp-ppt --output dist/slides --html",
    "watch": "marp --config marp.config.mjs --input-dir marp-ppt --output dist/slides --pdf --watch"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.2.3"
  }
}
