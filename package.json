{
  "name": "project-csap-cmp223",
  "private": true,
  "version": "1.0.0",
  "description": "Slides e artigo do trabalho de CMP223 (INF-UFRGS)",
  "scripts": {
    "pdf": "marp --config marp.config.mjs --input-dir slides --output dist/slides --pdf",
    "pptx": "marp --config marp.config.mjs --input-dir slides --output dist/slides --pptx",
    "html": "marp --config marp.config.mjs --input-dir slides --output dist/slides --html",
    "watch": "marp --config marp.config.mjs --input-dir slides --output dist/slides --pdf --watch",
    "diagrams": "node diagrams/build.mjs -f svg",
    "diagrams:png": "node diagrams/build.mjs -f png",
    "diagrams:all": "node diagrams/build.mjs -f svg,png -v claro,escuro"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.2.3",
    "@mermaid-js/mermaid-cli": "11.16.0"
  }
}
