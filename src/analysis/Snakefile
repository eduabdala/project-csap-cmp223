# ============================================================
# Snakefile — Reproducible collection and analysis pipeline (CMP223).
#
# Flow (see the draft flowchart):
#   build (avr-gcc) -> flash (avrdude) -> collect (scope + LA + stack)
#   -> parse/integration (E = INT V*i dt) -> statistics (95% CI) -> table/figures
#
# Usage (inside `nix develop`):
#   snakemake -j1 --configfile config.yaml all
#   snakemake -n            # dry-run (inspect the job DAG)
#
# STATUS: skeleton. The HARDWARE rules (flash/collect) have placeholders marked
# with TODO because they depend on the physical bench being connected.
# ============================================================

import random
from design import load_levels, build_design, FACTORS

configfile: "config.yaml"

ALGS   = config["algorithms"]
VARS   = config["variants"]
CLOCKS = [str(c) for c in config["clock_mhz"]]
OPTS   = config["optimization"]
OPS    = config["operations"]
N      = config["iterations"]
RAW    = config["raw_dir"]
PROC   = config["proc_dir"]

# Filename-safe label (e.g. "-Os" -> "Os").
def opt_tag(o): return o.lstrip("-")

# Factor matrix generated with pyDOE3 (see design.py). This replaces the manual
# itertools.product: the design is a named, citable method and can be switched
# to a fractional design via config["design"] if the bench time is too long.
_levels = load_levels(config)
_design = build_design(_levels, kind=config.get("design", "full"),
                       generator=config.get("fraction_generator"))
# Rows as (alg, var, clock, opt) tuples, matching the previous COMBOS shape.
COMBOS = [tuple(row[f] for f in FACTORS) for row in _design]

# ---- Final target ------------------------------------------
rule all:
    input:
        f"{PROC}/summary_table.csv",
        f"{PROC}/figures/trade_off.pdf"

# ---- 0. Experiment design (pyDOE3) -------------------------
# Writes the factor matrix as a citable artifact. Not a build dependency of the
# runs (COMBOS is computed in-process above), but kept so the plan is on disk.
rule design:
    output:
        csv=f"{PROC}/design.csv"
    shell:
        "python design.py --config config.yaml --out {output.csv}"

# ---- 1. Parameterized build (avr-gcc) ----------------------
rule build:
    output:
        hex=f"{RAW}/bin/firmware-{{alg}}-{{var}}-{{clock}}MHz-{{opt}}.hex",
        size=f"{RAW}/bin/size-{{alg}}-{{var}}-{{clock}}MHz-{{opt}}.txt"
    params:
        fcpu=lambda w: f"{int(w.clock)*1000000}UL",
        fw=config["firmware_dir"]
    shell:
        r"""
        make -C {params.fw} clean
        make -C {params.fw} ALG={wildcards.alg} VARIANT={wildcards.var} \
             OPT=-{wildcards.opt} F_CPU={params.fcpu}
        mkdir -p $(dirname {output.hex})
        cp {params.fw}/build/firmware-{wildcards.alg}-{wildcards.var}.hex {output.hex}
        make -C {params.fw} ALG={wildcards.alg} VARIANT={wildcards.var} \
             OPT=-{wildcards.opt} F_CPU={params.fcpu} size > {output.size}
        """

# ---- 2. Flash (avrdude via UPDI) ---------------------------
# TODO(bench): runs only with the board connected. Treated as a manual checkpoint.
rule flash:
    input:
        hex=f"{RAW}/bin/firmware-{{alg}}-{{var}}-{{clock}}MHz-{{opt}}.hex"
    output:
        touch(f"{RAW}/flashed/{{alg}}-{{var}}-{{clock}}MHz-{{opt}}.ok")
    params:
        mcu="atmega4809", port=config["serial_port"]
    shell:
        r"""
        stty -F {params.port} 1200 hupcl && sleep 0.5
        avrdude -c jtag2updi -p {params.mcu} -P {params.port} -b 115200 -e -D \
                -U flash:w:{input.hex}:i
        """

# ---- 3. Collect one iteration ------------------------------
# TODO(bench): trigger the operation over serial and capture scope + LA +
# stack dump. Depends on the oscilloscope driver and sigrok-cli.
rule collect:
    input:
        flashed=f"{RAW}/flashed/{{alg}}-{{var}}-{{clock}}MHz-{{opt}}.ok"
    output:
        csv=f"{RAW}/runs/{{alg}}-{{var}}-{{clock}}MHz-{{opt}}-{{op}}-{{i}}.csv"
    params:
        port=config["serial_port"], baud=config["baud"]
    shell:
        r"""
        python collect.py \
            --op {wildcards.op} --port {params.port} --baud {params.baud} \
            --out {output.csv}
        """

# ---- 4. Parse + numerical integration per iteration --------
rule parse:
    input:
        csv=f"{RAW}/runs/{{alg}}-{{var}}-{{clock}}MHz-{{opt}}-{{op}}-{{i}}.csv"
    output:
        row=f"{PROC}/rows/{{alg}}-{{var}}-{{clock}}MHz-{{opt}}-{{op}}-{{i}}.json"
    params:
        shunt=config["shunt_ohms"]
    shell:
        r"""
        python parse.py --in {input.csv} --shunt {params.shunt} --out {output.row}
        """

# ---- 5. Statistical aggregation (mean, 95% CI, outliers) ---
def all_rows(wildcards):
    rng = random.Random(config["seed"])
    rows = []
    for alg, var, clock, opt in COMBOS:
        for op in OPS:
            for i in range(N):
                rows.append(
                    f"{PROC}/rows/{alg}-{var}-{clock}MHz-{opt_tag(opt)}-{op}-{i}.json"
                )
    rng.shuffle(rows)   # randomized execution order (DoE)
    return rows

rule aggregate:
    input:
        all_rows
    output:
        table=f"{PROC}/summary_table.csv"
    shell:
        "python aggregate.py --in {input} --out {output.table}"

# ---- 6. Final figures --------------------------------------
rule figures:
    input:
        table=f"{PROC}/summary_table.csv"
    output:
        fig=f"{PROC}/figures/trade_off.pdf"
    shell:
        "python figures.py --in {input.table} --out {output.fig}"
